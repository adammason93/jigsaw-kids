# Worker entry source must not ship as browseable static files with assets.directory="."
workers-site/
# Git repository and dotfiles (Workers Builds deploys from a full checkout)
.git/
.gitignore
.assetsignore
# Build output and account cache written by wrangler during deploy
.wrangler/
# Repo / editor / tooling folders the site never serves
.github/
.vscode/
.claude/
.cursor/
ai-dev/
android/
# Database, notes, tests, and local generators are not website assets
supabase/
docs/
tests/
scripts/
# Worker config is read locally by Wrangler and must not be downloadable
wrangler.jsonc
# Secrets and local environment. A clean checkout does not contain these.
.env
.env.*
.dev.vars
.dev.vars.*
